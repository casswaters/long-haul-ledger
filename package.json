{
  "name": "long-haul-ledger",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "description": "Long Haul Ledger — US industrial ledger: free world atlas, US Progress rail, US desks (Prices sample wired)",
  "scripts": {
    "test": "node ledger.test.js && node stats.test.mjs",
    "fetch": "node scripts/fetch-signals.mjs",
    "fetch:prices": "node scripts/fetch-prices.mjs",
    "shots": "node shots.mjs",
    "curated:check": "node -e \"import('./curated.js').then(m=>{const e=m.validateCurated(JSON.parse(require('fs').readFileSync('data/signals-curated.json','utf8')));if(e.length){console.error(e.join('\\n'));process.exit(1)}console.log('signals-curated.json OK')})\"",
    "curated:apply": "node scripts/fetch-signals.mjs --curated-only"
  }
}
