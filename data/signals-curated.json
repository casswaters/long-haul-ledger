      "location": {
        "countries": [
          "us"
        ],
        "admin1": [
          "us-la"
        ]
      },
      "tags": [
        "energy",
        "oil",
        "natural gas",
        "offshore"
      ],
      "blurb": "About 511,619 barrels a day of Gulf offshore oil (about 25%) and about 350 million cubic feet a day of gas (about 16%) were offline as of midday Oct. 7, per Marine Minerals Administration operator reports cited by Argus, up from 9.24% of oil a day earlier. Chevron and Shell evacuated staff from several facilities; the storm was forecast to become a hurricane Thursday.",
      "status": "confirmed",
      "sources": [
        {
          "name": "Marine Minerals Administration (BSEE newsroom), Oct. 6 shut-in report",
          "url": "https://www.bsee.gov/newsroom/latest-news/statements-and-releases/press-releases/mma-monitors-gulf-activities-invest-92l",
          "primary": true,
          "published": "2026-10-06"
        },
        {
          "name": "Argus Media",
          "url": "https://www.argusmedia.com/en/news-and-insights/latest-market-news/2887918-us-gulf-operators-shut-in-output-before-storm-update",
          "primary": false,
          "published": "2026-10-07"
        }
      ],
      "note": "Feed had only an analysis piece and an LNG angle. The regulator published the storm shut-in data (Oct. 6 report opened); Argus carries the Oct. 7 update.",
      "addedAt": "2026-10-08T00:40:00Z",
      "addedBy": "Ledger research (hand-verified)"
    },
